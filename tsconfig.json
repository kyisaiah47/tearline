{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@compound/landing/product": [
        "./src/landing.config.ts"
      ],
      "@compound/landing/adapters/pricing": [
        "./src/lib/pricing.ts"
      ],
      "@compound/landing/adapters/product": [
        "./src/lib/product.ts"
      ],
      "@compound/landing/adapters/surfaces": [
        "./src/lib/surfaces.ts"
      ],
      "@compound/landing/adapters/Icon": [
        "./src/lib/IconAdapter.tsx"
      ],
      "@compound/landing/*": [
        "./vendor/component-library/packages/landing/frame/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-verify/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-probe/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor/component-library"
  ]
}
