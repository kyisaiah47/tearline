    "custom-element",
    "custom-elements",
    "share-image",
    "png-export",
    "dom-to-png",
    "dom-to-image",
    "receiptify",
    "shadow-dom",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Kynth Studios (https://kynth.studio)",
