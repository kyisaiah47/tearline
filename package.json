{
  "name": "tearline",
  "version": "0.1.0",
  "description": "Wrap any HTML in one tag and it prints out as a thermal receipt. Save it as a PNG. Zero dependencies, no build step.",
  "type": "module",
  "main": "src/tearline.js",
  "module": "src/tearline.js",
  "exports": {
    ".": "./src/tearline.js"
  },
  "files": [
    "src/tearline.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "receipt",
    "thermal-receipt",
    "web-component",
    "custom-element",
    "share-image",
    "png-export",
    "receiptify"
  ],
  "license": "MIT",
  "sideEffects": [
    "./src/tearline.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyisaiah47/tearline.git"
  },
  "homepage": "https://tearline.kynth.studio",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync": "cp src/tearline.js public/tearline.js",
    "verify": "NEXT_DIST_DIR=.next-verify next build"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lenis": "^1.1.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "eslint": "^9",
    "eslint-config-next": "15.5.22"
  },
  "private": true
}
